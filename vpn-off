#!/bin/sh
STATE=/tmp/vpn-state

if ! pgrep -x openvpn >/dev/null 2>&1; then
    notify-send "VPN" "Not connected"
    exit 0
fi

notify-send "VPN" "Disconnecting..."
sudo pkill -x openvpn

for i in $(seq 1 10); do
    pgrep -x openvpn >/dev/null 2>&1 || break
    sleep 1
done

# Remove the IPv6 block vpn-on added - but not if tor-on's own independent
# block is also active right now, since this shares the same OUTPUT chain
# and would blow that away too, silently leaving tor-state="on" leaking IPv6.
if [ "$(cat /tmp/tor-state 2>/dev/null)" != "on" ]; then
    sudo ip6tables -F OUTPUT
    sudo ip6tables -P OUTPUT ACCEPT
fi

echo "off" > "$STATE"
notify-send "VPN" "Disconnected"
