#!/usr/bin/env bash
# Terminal screensaver matching Omarchy's — random TTE (terminaltexteffects)
# effects over the current hostname (figlet'd + scaled to fill whatever
# terminal it's running in), looping until any keypress. Meant to be invoked
# from zsh's TRAPALRM on shell idle timeout, or by noctalia's idle system via
# launch-screensaver — same script either way, no separate size config: the
# scale is computed fresh each run from the actual terminal dimensions, so a
# small terminal and a fullscreen window each get an appropriately sized word.
#
# tte runs backgrounded and gets polled for a keypress every 0.1s WHILE it
# animates (not just between cycles) so dismissal is near-instant instead of
# waiting out whatever effect happens to be mid-play.

ART_FILE=$(mktemp)
PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/org.zorro.screensaver.pid"
echo $$ > "$PIDFILE"
tte_pid=""

exit_screensaver() {
    [ -n "$tte_pid" ] && kill -TERM "$tte_pid" 2>/dev/null
    # Drain any leftover bytes (e.g. the trailing "[A" of an arrow-key escape
    # sequence whose first byte woke the read loop below) so they don't leak
    # into whatever regains focus once this window closes.
    while read -t 0.02 -n 1 -s _; do :; done
    stty sane 2>/dev/null
    printf '\033[?1049l\033[?25h'  # leave alternate screen, ensure cursor visible
    rm -f "$ART_FILE" "$PIDFILE"
    exit 0
}
trap exit_screensaver INT TERM HUP QUIT

RAW_ART=$(figlet -f big "$(hostname)" | awk '
{ a[NR] = $0 }
END {
    first = 1
    last = NR
    while (first <= last && a[first] ~ /^[ \t]*$/) first++
    while (last >= first && a[last] ~ /^[ \t]*$/) last--
    for (i = first; i <= last; i++) print a[i]
}')

render_art() {
    COLS=$(tput cols 2>/dev/null || echo 80)
    ROWS=$(tput lines 2>/dev/null || echo 24)
    SCALE=$(printf '%s\n' "$RAW_ART" | awk -v cols="$COLS" -v rows="$ROWS" '
    { if (length($0) > maxw) maxw = length($0) }
    END {
        nrows = NR
        scale_w = (cols * 0.9) / maxw
        scale_h = (rows * 0.9) / nrows
        scale = (scale_w < scale_h) ? scale_w : scale_h
        if (scale < 1) scale = 1
        printf "%.2f", scale
    }')
    printf '%s\n' "$RAW_ART" | awk -v scale="$SCALE" '
    {
        lines[NR] = $0
        if (length($0) > maxw) maxw = length($0)
    }
    END {
        nrows = NR
        new_rows = int(nrows * scale + 0.5)
        new_cols = int(maxw * scale + 0.5)
        for (r = 0; r < new_rows; r++) {
            src_r = int(r / scale) + 1
            if (src_r > nrows) src_r = nrows
            line = lines[src_r]
            out = ""
            for (c = 0; c < new_cols; c++) {
                src_c = int(c / scale) + 1
                ch = substr(line, src_c, 1)
                if (ch == "") ch = " "
                out = out ch
            }
            print out
        }
    }' > "$ART_FILE"
}

printf '\033[?1049h\033[2J\033[H'  # enter alternate screen, cleared

# launch-screensaver dispatches the fullscreen resize just after this window
# is created, which lands slightly after this script starts — without a
# beat to let it land, the very first render reads the small pre-fullscreen
# terminal size.
sleep 0.5

while true; do
    render_art
    tte -i "$ART_FILE" \
        --frame-rate 60 --canvas-width 0 --canvas-height 0 --reuse-canvas \
        --anchor-canvas c --anchor-text c --random-effect --no-eol \
        --no-restore-cursor &
    tte_pid=$!

    while kill -0 "$tte_pid" 2>/dev/null; do
        if read -t 0.1 -n 1 -s _; then
            exit_screensaver
        fi
    done
    wait "$tte_pid" 2>/dev/null
    tte_pid=""

    if read -t 0.1 -n 1 -s _; then
        exit_screensaver
    fi
done
